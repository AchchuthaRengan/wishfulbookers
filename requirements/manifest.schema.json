{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://navlands.local/schemas/requirements-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "goalCatalogs", "validations", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "goalCatalogs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^VAL-[A-Z0-9-]+$" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "goalIds",
          "implementationGlobs",
          "validationIds",
          "validationGlobs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HARNESS-(?:REQ|VER)-[0-9]{3}$"
          },
          "source": { "type": "string", "pattern": "^[^#]+#[a-z0-9-]+$" },
          "goalIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^NAV-(?:FEATURE|SCREEN)-[0-9]{3}$"
            }
          },
          "implementationGlobs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "validationIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^VAL-[A-Z0-9-]+$" }
          },
          "validationGlobs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
